<%layout('layouts/boilerplate')%>
<body>
    <h1>All Listings</h1>
    <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1">
          <% for(let list of alllisting){ %>
       <a href="/listings/<%=list._id%>">
         <div class="card col" >
  <img src="<%=list.image%>" class="card-img-top" alt="list image" style="height: 20rem;">
  <div class="card-img-overlay">abc</div>
  <div class="card-body">
    <h5 class="card-title"><b><%=list.title%></b></h5>
    <p class="card-text">&#8377; <%=list.price.toLocaleString("en-IN")%>/night</p>
  </div>
</div>
       </a>
  <%  } %>
    </div>
</body>
