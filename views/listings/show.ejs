<%layout('layouts/boilerplate')%>
<div class="row">
    <div class="col-8 offset-2">
    <h1>Listing Details:</h1>
    <div class="card">
  <img src="<%=list.image%>" class="card-img-top show-img" alt="listing_image">
  <div class="card-body">
    <p class="card-text"><b><%=list.title%></b> <br>
        <%=list.description%> <br>
        &#8377; <%=list.price.toLocaleString("en-IN")%> <br>
        <%=list.location%> <br>
        <%=list.country%>
    </p>
  </div>
    </div>
    <br>
    <a href="/listings/<%=list._id%>/edit" class="btn btn-dark edit-btn">Edit this Listing</a>
    <br>
    <br>
    <form method="POST" action="/listings/<%=list._id%>?_method=DELETE">
        <button class="btn btn-dark">Delete this listing</button>
    </form>
</div>
</div>