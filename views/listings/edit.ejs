<% layout("layouts/boilerplate") %>
<div class="row">
    <div class="col-8 offset-2">
<body>
    <h3>Edit the Inputs</h3>
    <form method="POST" action="/listings/<%=list._id%>?_method=PUT" novalidate class="needs-validation" enctype="multipart/form-data" >
        <div class="mb-3">
        <label for="title" class="form-label">Title</label>
        <input name="listing[title]"value="<%=list.title%>" class="form-control" type="text">
        </div>
        <div class="mb-3">
        <label for="description" class="form-label">Description</label>
        <textarea name="listing[description]" class="form-control"><%=list.description%></textarea>
        </div>

        <div class="mb-3">
            Original Image:
            <br>
            <img src="<%=originalImageURL%>"/>
        </div>

        <div class="mb-3">
            <label for="image" class="form-label">Upload Image</label>
            <input name="listing[image]" type="file" class="form-control" required>
        </div>
        <div class="row">
        <div class="mb-3 col-md-3">
            <label for="price" class="form-label">Price</label>
            <input name="listing[price]" value="<%=list.price%>" class="form-control" type="number">
        </div>
        <div class="mb-3 col-md-6">
            <label for="country" class="form-label">Country</label>
            <input name="listing[country]" value="<%=list.country%>" class="form-control" type="text">
        </div>
        </div>
        <div class="mb-3 col-md-3">
            <label for="location" class="form-label">Location</label>
            <input name="listing[location]" value="<%=list.location%>" class="form-control" type="text">
        </div>
        <button class="btn btn-dark edit-btn">Edit</button>
    </form>
</body>
</div>
</div>
