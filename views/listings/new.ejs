<% layout("layouts/boilerplate") %>
     <div class="row">
        <div class="col-8 offset-2">
            <h3>Give me the Inputs</h3>
    <form method="POST" action="/listings" class="needs-validation" novalidate enctype="multipart/form-data">
        <div class="mb-3">
        <label for="title" class="form-label">Title</label>
        <input name="listing[title]" class="form-control" placeholder="Give me the title" type="text" required>
        <div class="invalid-feedback">
            Please give a title.
        </div>
        </div>
        <div class="mb-3">
             <label for="description" class="form-label">Description</label>
             <textarea name="listing[description]" class="form-control" placeholder="Give me desc" required></textarea>
        <div class="invalid-feedback">
            Please give a description.
        </div>
        </div>
        <div class="mb-3">
            <label for="image" class="form-label">Upload Image </label>
            <input name="listing[image]" class="form-control" type="file" >
        </div>
        <div class="row">
            <div class="mb-3 col-md-3"> 
            <label for="price" class="form-label">Price</label>
            <input name="listing[price]" class="form-control" placeholder="Set the Price" type="text" required>
        </div>
        <div class="mb-3 col-md-6"> 
            <label for="country" class="form-label">Country</label>
            <input name="listing[country]" class="form-control" placeholder="Give me the Country" type="text" required>
            <div class="invalid-feedback">
                Please give a country.
            </div>
        </div> 
        </div>
        <div class="mb-3">
            <label for="location" class="form-label">Location</label>
            <input name="listing[location]" class="form-control" placeholder="Give me the Location" type="text" required >
            <div class="invalid-feedback">
                Please give a location.
            </div>
        </div>
        <br> <br>
        <button class="btn btn-dark add-btn">Add</button>
    </form>
        </div>
     </div>
